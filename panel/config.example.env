# Panel web autoalojado. Copia a config.env (junto a app.py) y rellena. config.env no se sube a git.
# Formato KEY=valor, sin comillas ni comentarios en la misma línea (vale para python app.py y para docker --env-file).
# app.py NO arranca si faltan SESSION_KEY/FERNET_KEY o si, sin Stripe, no dices quién puede entrar (ALLOWED_EMAILS).
BASE_URL=https://tu-dominio.example
OPERADOR=Tu Nombre o Empresa, NIF 00000000X
# Tus cuentas de Google que pueden entrar, separadas por comas (obligatorio sin Stripe)
ALLOWED_EMAILS=tu-email@gmail.com
# python3 -c "import secrets;print(secrets.token_urlsafe(32))"
SESSION_KEY=
# python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FERNET_KEY=
# Google Cloud > Credenciales > Cliente OAuth web; redirect BASE_URL/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# La IA que redacta (o cambia ia.py por tu proveedor)
ANTHROPIC_API_KEY=
IA_MODEL=claude-haiku-5-5
TOPE_DIARIO=40
DB_PATH=/data/celestia.db
# Evolution API propia para WhatsApp (opcional)
EVO_URL=http://evolution:8080
EVO_KEY=
# Opcionales: Instagram (API oficial de Meta)
META_APP_ID=
META_APP_SECRET=
IG_CONFIG_ID=
IG_VERIFY_TOKEN=
# Opcional: entrada para TU propio lector de apps de citas (POST /bridge/citas con cabecera X-Bridge-Secret).
# Este repo no trae ese lector; déjalo vacío si no lo tienes. Si lo usas: 32+ caracteres al azar.
BRIDGE_SECRET=
BRIDGE_EMAIL=
# Opcionales: cobro con Stripe. Sin STRIPE_SECRET_KEY no hay cobro y solo entran las cuentas de ALLOWED_EMAILS.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE=
STRIPE_PORTAL_CONFIG=
