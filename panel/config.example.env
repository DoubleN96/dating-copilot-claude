# Panel web autoalojado (python app.py o Docker). Copia a config.env y rellena (config.env no se sube a git).
BASE_URL=https://tu-dominio.example
OPERADOR=Tu Nombre o Empresa, NIF 00000000X
SESSION_KEY=""            # python3 -c "import secrets;print(secrets.token_urlsafe(32))"
FERNET_KEY=""             # python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
GOOGLE_CLIENT_ID=""       # Google Cloud > Credenciales > Cliente OAuth web; redirect BASE_URL/auth/callback
GOOGLE_CLIENT_SECRET=""   # del mismo cliente OAuth
ANTHROPIC_API_KEY=""      # la IA que redacta (o cambia ia.py por tu proveedor)
IA_MODEL=claude-haiku-5-5
EVO_URL=http://evolution:8080   # Evolution API propia para WhatsApp (opcional)
EVO_KEY=""                # clave global de tu Evolution API
TOPE_DIARIO=40
DB_PATH=/data/celestia.db
# Opcionales: Instagram (API oficial de Meta)
META_APP_ID=""
META_APP_SECRET=""
IG_CONFIG_ID=""
IG_VERIFY_TOKEN=""
# Opcionales: puente de lectura de apps de citas (citas/*.py -> POST /bridge/citas)
BRIDGE_SECRET=""
BRIDGE_EMAIL=""
# Opcionales: cobro con Stripe. Si STRIPE_SECRET_KEY está vacío, todo queda abierto (uso personal).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE=""
STRIPE_PORTAL_CONFIG=""
