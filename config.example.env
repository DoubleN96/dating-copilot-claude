# Copia a config.env (NO lo subas a git) y rellena. launch.sh y ronda.sh lo cargan; Claude y los scripts lo heredan.
OWNER_NAME="Tu nombre"
OWNER_CHAT_ID="123456789"              # tu chat_id de Telegram (el del dueño; el bot solo obedece a este)
OWNER_WHATSAPP="+34 6XX XX XX XX"      # lo da el bot al pasar la conversación a WhatsApp
OWNER_INSTAGRAM="@tu_usuario"          # alternativa si ella prefiere Instagram

TZ_NAME="Europe/Madrid"
CALENDAR_SLOTS="2:18-24,3:18-24"       # weekday (0=lunes):hora_inicio-hora_fin -> huecos para citas (aquí mié y jue 18-24 h)
GOOGLE_CALENDAR_CREDS="~/.secrets/google_calendar.json"   # {"client_id","client_secret","refresh_token"} (chmod 600)

CDP_PORT="9250"                        # puerto local del Chromium aislado (túnel SSH)
ANDROID_SERIAL="127.0.0.1:5556"        # adb del redroid
MIN_SECONDS="45"                       # mínimo entre dos envíos
MAX_PER_DAY="40"                       # tope de envíos al día entre todas las apps

TMUX_SESSION="copiloto"                # nombre del tmux donde corre Claude (lo usa ronda.sh)
COPILOTO_DIR="$HOME/citas"             # carpeta con los scripts (la PAUSA vive aquí)
PYTHON="python3"

# WhatsApp del dueño vía Evolution API (opcional; ver docs/INSTALL.md §9). El copiloto sigue ahí la conversación
EVOLUTION_URL="https://evolution.example.com"   # tu Evolution API self-hosted (https)
EVOLUTION_INSTANCE="mi-whatsapp"                # instancia donde vinculaste TU WhatsApp por QR
EVOLUTION_API_KEY=""                            # AUTHENTICATION_API_KEY global o el token de la instancia
WA_DEFAULT_PREFIX="34"                          # prefijo de país para números escritos sin él
WA_LOCAL_DIGITS="9"                             # números con estos dígitos o menos se consideran nacionales

# SMS Forwarder -> n8n (opcional, solo para códigos de login)
N8N_API_URL="https://tu-n8n.example.com"
N8N_API_KEY=""
N8N_SMS_WORKFLOW_ID=""
